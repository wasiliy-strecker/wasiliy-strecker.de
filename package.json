{
  "name": "wasiliy-strecker-de",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual developer portfolio for Wasiliy Strecker.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 53545",
    "build": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
